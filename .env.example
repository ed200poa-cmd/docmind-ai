# ─── Required ────────────────────────────────────────────────────────────────
# Anthropic Claude API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional ────────────────────────────────────────────────────────────────
# Public URL of this server (used for Railway / production deployments)
BASE_URL=https://your-app.up.railway.app

# Port (Railway sets this automatically; default is 8000 locally)
PORT=8000
